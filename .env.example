# Copy to .env locally. Never commit real credentials.
# PayPal REST Sandbox app credentials (Catalog API uses client credentials)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# PayPal Login / Identity app configuration; may use the REST credentials if same app is enabled for Login
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=
PAYPAL_LOGIN_REDIRECT_URI=http://localhost:8080/api/auth/paypal/callback

# Enable PayPal-session protection for intent and catalog APIs after Login is configured
INTENTOS_AUTH_REQUIRED=false
INTENTOS_FRONTEND_URL=http://localhost:5173

# Elastic Cloud persistence (API key value must be the encoded API key)
INTENTOS_ELASTIC_ENABLED=false
INTENTOS_ELASTIC_URL=
INTENTOS_ELASTIC_API_KEY=

# Intent extraction via Amazon Bedrock (AWS credentials come from the AWS profile locally or EC2 role in deployment)
INTENTOS_LLM_ENABLED=false
INTENTOS_LLM_REGION=us-east-1
INTENTOS_LLM_MODEL_EXTRACTION=amazon.nova-micro-v1:0
INTENTOS_LLM_MODEL_REASONING=amazon.nova-lite-v1:0
INTENTOS_LLM_MODEL_REPAIR=amazon.nova-lite-v1:0
INTENTOS_LLM_MODEL_EXPLANATION=amazon.nova-micro-v1:0
INTENTOS_LLM_MAX_TOKENS=700
