{
  "inputs": [
    {
      "id": "paypal-sandbox-client-id",
      "type": "promptString",
      "description": "PayPal Sandbox REST app client ID"
    },
    {
      "id": "paypal-sandbox-client-secret",
      "type": "promptString",
      "password": true,
      "description": "PayPal Sandbox REST app client secret"
    }
  ],
  "servers": {
    "paypal-catalog-readonly": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/paypal-catalog-mcp.js"],
      "env": {
        "PAYPAL_CLIENT_ID": "${input:paypal-sandbox-client-id}",
        "PAYPAL_CLIENT_SECRET": "${input:paypal-sandbox-client-secret}",
        "PAYPAL_ENVIRONMENT": "SANDBOX"
      }
    }
  }
}
